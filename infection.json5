{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "build/infection.log"
    },
    // a mutant process compiles one test container per configuration it boots, so a mutant of
    // the detector, which most functional tests cover, can exceed the default 10 seconds
    "timeout": 60,
    "mutators": {
        "@default": true
    },
    // Measured 2026-10-21 on PHP 8.4.26: 1037 mutants, 1035 killed, 2 timed out (counted as detected), MSI 100%, covered MSI 100%
    "minMsi": 100,
    "minCoveredMsi": 100
}
